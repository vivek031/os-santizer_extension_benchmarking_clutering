### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# JetBrains
.idea/

# Ghidra investigation folder
investigation/

os-sanitizer-ebpf/src/binding.rs

# crash dumps / scratch logs
*.core
vgcore.*
~san.log
__pycache__/
# large generated data (GitHub rejects files > 100 MB)
evaluation/quickbench/results/
evaluation/quickbench/inputs/data.tar
evaluation/quickbench/inputs/corpus.txt
calibration/data/enriched_*/
